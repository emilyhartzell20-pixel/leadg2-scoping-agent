# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# HubSpot private app access token (Settings → Integrations → Private Apps)
# Scopes: crm.objects.companies.read, crm.objects.contacts.read, crm.objects.deals.read,
#         sales-email-read (email bodies), e-commerce (read Products = your price list).
#         Call transcripts also need conversation intelligence access.
HUBSPOT_ACCESS_TOKEN=

# Password for the internal tool (proposal share links stay public). Leave blank locally.
APP_USERNAME=leadg2
APP_PASSWORD=

# Proposal storage. On Render: DATA_DIR=/var/data (the persistent disk in render.yaml).
DATA_DIR=

# Or Upstash Redis (any host) (Vercel Marketplace → Upstash, which sets these for you).
# Without these, proposals are written to ./.data (fine locally, NOT persistent on Vercel).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Shown on the "Next Steps" slide / section
LEADG2_CONTACT_NAME=LeadG2 Solutions Team
LEADG2_CONTACT_TITLE=Lead Consultant
LEADG2_CONTACT_EMAIL=
LEADG2_CONTACT_PHONE=
LEADG2_CONTACT_WEBSITE=leadg2.com


# Hourly rate for custom work and service points (1 point = 1 hour). Defaults to 125.
NEXT_PUBLIC_LEADG2_HOURLY_RATE=125

# Consulting retainer — marketing, HubSpot, or both. Defaults to 2000.
NEXT_PUBLIC_LEADG2_CONSULTING_MONTHLY=2000
